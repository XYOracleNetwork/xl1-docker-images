{
  "name": "@xyo-network/xl1-docker-images",
  "version": "5.2.1",
  "description": "Docker images, Compose recipes, and config examples for running XL1 network nodes",
  "keywords": [
    "xyo",
    "xl1",
    "docker",
    "container",
    "blockchain"
  ],
  "homepage": "https://xyo.network",
  "bugs": {
    "url": "https://github.com/XYOracleNetwork/xl1-docker-images/issues",
    "email": "support@xylabs.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XYOracleNetwork/xl1-docker-images.git"
  },
  "license": "LGPL-3.0-only",
  "author": {
    "name": "XY Labs Development Team",
    "email": "support@xylabs.com",
    "url": "https://xylabs.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.mjs"
    },
    "./entrypoint": {
      "types": "./dist/node/entrypoint.d.ts",
      "default": "./dist/node/entrypoint.mjs"
    },
    "./childEnv": {
      "types": "./dist/node/childEnv.d.ts",
      "default": "./dist/node/childEnv.mjs"
    },
    "./roles": {
      "types": "./dist/node/roles.d.ts",
      "default": "./dist/node/roles.mjs"
    },
    "./presets": {
      "types": "./dist/node/presets/index.d.ts",
      "default": "./dist/node/presets/index.mjs"
    },
    "./presets/buildPresetConfig": {
      "types": "./dist/node/presets/buildPresetConfig.d.ts",
      "default": "./dist/node/presets/buildPresetConfig.mjs"
    },
    "./presets/deepMerge": {
      "types": "./dist/node/presets/deepMerge.d.ts",
      "default": "./dist/node/presets/deepMerge.mjs"
    },
    "./presets/loadPresetFiles": {
      "types": "./dist/node/presets/loadPresetFiles.d.ts",
      "default": "./dist/node/presets/loadPresetFiles.mjs"
    },
    "./presets/types": {
      "types": "./dist/node/presets/types.d.ts",
      "default": "./dist/node/presets/types.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docker",
    "compose",
    "examples",
    "presets",
    "scripts",
    "README.md",
    "LICENSE",
    "!**/*.bench.*",
    "!**/*.spec.*",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "xy build",
    "build-image": "./scripts/build-image.sh",
    "compile": "xy compile",
    "entrypoint": "node ./dist/node/entrypoint.mjs",
    "fix": "xy fix",
    "lint": "xy lint",
    "smoke-run": "./scripts/smoke-run.sh",
    "test": "xy test"
  },
  "devDependencies": {
    "@ariestools/eslint-config-flat": "~10.1.3",
    "@ariestools/toolchain": "~10.1.3",
    "@ariestools/tsconfig": "~10.1.3",
    "@types/node": "~26.6.4",
    "eslint": "~10.12.0",
    "eslint-import-resolver-typescript": "~4.4.5",
    "typescript": "~6.0.3",
    "vite": "~8.3.4",
    "vitest": "~5.0.3"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "engines": {
    "node": ">=24"
  },
  "engineStrict": true,
  "volta": {
    "node": "26.11.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

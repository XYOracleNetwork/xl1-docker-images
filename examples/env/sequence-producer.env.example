# Federated Sequence producer — minimal operator surface.
# Requires image entrypoint with XL1_NETWORK + XL1_ROLE set.
#
# docker run --rm --env-file sequence-producer.env xl1:local

XL1_NETWORK=sequence
XL1_ROLE=producer

# REQUIRED
XL1_MNEMONIC=
XL1_REWARD_ADDRESS=

# Optional overrides
# XL1_CHAIN__ID=dd381FBB392C85160d8B0453E446757b12384046
# XL1_RPC_URL=https://beta.api.chain.xyo.network/rpc
# XL1_EVM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

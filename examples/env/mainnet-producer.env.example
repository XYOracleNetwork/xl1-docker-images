# Federated mainnet producer — minimal operator surface.
#
# docker run --rm --env-file mainnet-producer.env xl1:local

XL1_NETWORK=mainnet
XL1_ROLE=producer

# REQUIRED
XL1_MNEMONIC=
XL1_REWARD_ADDRESS=
# Mainnet preset leaves chain.id empty until published in-repo — set it here:
XL1_CHAIN__ID=

# Optional overrides
# XL1_RPC_URL=https://api.chain.xyo.network/rpc
# XL1_EVM_RPC_URL=https://ethereum-rpc.publicnode.com

# XL1 API node — copy to api.env and fill secrets before use.
# docker run --env-file api.env -p 8080:8080 -p 9099:9099 xl1:local start api

XL1_LOG_LEVEL=info
XL1_HEALTH_CHECK_PORT=9099

# REQUIRED: root mnemonic (never commit a real phrase)
XL1_MNEMONIC=

# Chain / EVM (set for the network you join)
# XL1_CHAIN__ID=dd381FBB392C85160d8B0453E446757b12384046
XL1_EVM__CHAIN_ID=0xaa36a7

# Actor slice (index 0)
XL1_ACTORS__0__NAME=api
XL1_ACTORS__0__HOST=0.0.0.0
XL1_ACTORS__0__PORT=8080
XL1_ACTORS__0__ACCOUNT_PATH=3

# Local store (container path; compose mounts a volume on /data)
XL1_CONNECTIONS__LOCAL_STORE__TYPE=lmdb
XL1_CONNECTIONS__LOCAL_STORE__ROOT=/data/.store

# Optional: remote RPC peer / EVM / S3 — see the other files in this directory
# XL1_CONNECTIONS__DEFAULT_RPC__TYPE=rpc
# XL1_CONNECTIONS__DEFAULT_RPC__PROTOCOL=http
# XL1_CONNECTIONS__DEFAULT_RPC__URL=http://api:8080/rpc
# XL1_CONNECTIONS__DEFAULT_EVM_RPC__TYPE=evm-rpc
# XL1_CONNECTIONS__DEFAULT_EVM_RPC__URL=http://host.docker.internal:8545

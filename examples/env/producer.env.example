# XL1 Producer node — MANUAL / SELF-HOSTED CHAIN.
#
#   docker compose -f compose/local-stack.yml --profile core up -d
#   docker run --env-file producer.env xl1:local start producer
#
# This does NOT join Sequence or mainnet. Provider bindings cannot be expressed
# as environment variables (`XL1_PROVIDER_BINDINGS__BLOCK_VIEWER__…` camel-cases
# the moniker to `blockViewer`, which matches nothing), so every viewer binds to
# the local store below and the node bootstraps and extends a chain of its own —
# even if you point XL1_CONNECTIONS__DEFAULT_RPC__URL at a public network and set
# a matching XL1_CHAIN__ID. That is the intended shape for compose/local-stack.yml.
#
# To join a public network as a federated producer, use preset mode instead:
#   examples/env/sequence-producer.env.example

XL1_LOG__LOG_LEVEL=info
XL1_HEALTH_CHECK_PORT=9099
XL1_MNEMONIC=

# Staking contract address — bare lowercase hex, no 0x. Omit to mint a new chain.
# XL1_CHAIN__ID=

XL1_ACTORS__0__NAME=producer
XL1_ACTORS__0__HOST=0.0.0.0
XL1_ACTORS__0__PORT=8081
XL1_ACTORS__0__ACCOUNT_PATH=0
# XL1_ACTORS__0__MIN_STAKE=100000000000000
# XL1_ACTORS__0__REWARD_ADDRESS=0x1111111111111111111111111111111111111111
# XL1_ACTORS__0__DISABLE_INTENT_REDECLARATION=false

XL1_CONNECTIONS__LOCAL_STORE__TYPE=lmdb
XL1_CONNECTIONS__LOCAL_STORE__ROOT=/data/.store

# Peers in a local stack (see compose/local-stack.yml)
# XL1_CONNECTIONS__DEFAULT_RPC__TYPE=rpc
# XL1_CONNECTIONS__DEFAULT_RPC__PROTOCOL=http
# XL1_CONNECTIONS__DEFAULT_RPC__URL=http://api:8080/rpc
# XL1_CONNECTIONS__DEFAULT_EVM_RPC__TYPE=evm-rpc
# XL1_CONNECTIONS__DEFAULT_EVM_RPC__URL=http://host.docker.internal:8545
# XL1_CONNECTIONS__DEFAULT_EVM_RPC__CHAIN_ID=0xaa36a7

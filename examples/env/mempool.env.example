# XL1 Mempool node (standalone RPC shape)
# docker run --env-file mempool.env -p 8084:8084 xl1:local start mempool

XL1_LOG_LEVEL=info
XL1_HEALTH_CHECK_PORT=9099
XL1_MNEMONIC=

# XL1_CHAIN__ID=
XL1_EVM__CHAIN_ID=0xaa36a7

XL1_ACTORS__0__NAME=mempool
XL1_ACTORS__0__ACCOUNT_PATH=4
XL1_ACTORS__0__SERVE_RPC=true
XL1_ACTORS__0__HOST=0.0.0.0
XL1_ACTORS__0__PORT=8084
# XL1_ACTORS__0__BLOCK_PRUNE_INTERVAL=10000
# XL1_ACTORS__0__TRANSACTION_PRUNE_INTERVAL=10000

XL1_CONNECTIONS__LOCAL_STORE__TYPE=lmdb
XL1_CONNECTIONS__LOCAL_STORE__ROOT=/data/.store

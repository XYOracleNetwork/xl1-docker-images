# XL1 Bridge node (typically needs Redis — see compose/local-stack.yml profile bridge)
# docker run --env-file bridge.env xl1:local start bridge

XL1_LOG__LOG_LEVEL=info
XL1_HEALTH_CHECK_PORT=9099
XL1_MNEMONIC=

# XL1_CHAIN__ID=

XL1_ACTORS__0__NAME=bridge
XL1_ACTORS__0__ACCOUNT_PATH=1
# XL1_ACTORS__0__HOST=0.0.0.0
# XL1_ACTORS__0__PORT=8082

XL1_CONNECTIONS__LOCAL_STORE__TYPE=lmdb
XL1_CONNECTIONS__LOCAL_STORE__ROOT=/data/.store

# XL1_CONNECTIONS__DEFAULT_EVM_RPC__TYPE=evm-rpc
# XL1_CONNECTIONS__DEFAULT_EVM_RPC__URL=http://host.docker.internal:8545
# XL1_CONNECTIONS__DEFAULT_EVM_RPC__CHAIN_ID=0xaa36a7

# BullMQ / Redis (host name `redis` when using local-stack compose)
# Configure via bridge-specific connection vars documented in packages/cli/packages/bridge

# XL1 Validator node
# docker run --env-file validator.env xl1:local start validator

XL1_LOG_LEVEL=info
XL1_HEALTH_CHECK_PORT=9099
XL1_MNEMONIC=

# XL1_CHAIN__ID=
XL1_EVM__CHAIN_ID=0xaa36a7

XL1_ACTORS__0__NAME=validator
XL1_ACTORS__0__ACCOUNT_PATH=7
# XL1_ACTORS__0__STEP=2
# XL1_ACTORS__0__STEP_CHECK_INTERVAL=10000

XL1_CONNECTIONS__LOCAL_STORE__TYPE=lmdb
XL1_CONNECTIONS__LOCAL_STORE__ROOT=/data/.store
